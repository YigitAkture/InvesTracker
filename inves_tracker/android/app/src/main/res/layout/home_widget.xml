<?xml version="1.0" encoding="utf-8"?>
<!--
    RemoteView-Compatible Home Widget Layout for InvesTracker
    Displays: 5 currencies + 3 precious metals + 3 cryptocurrencies
    Note: No ScrollView or View dividers - fully compatible with RemoteViews
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/app_widget_background">

    <!-- Header with Title, Update Time and Refresh Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="InvesTracker"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/widget_update_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Updated: --:--"
            android:textSize="9sp"
            android:textColor="#B3FFFFFF"
            android:layout_marginEnd="8dp" />

        <!-- Refresh Button -->
        <ImageButton
            android:id="@+id/refresh_button"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_popup_sync"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Refresh"
            android:scaleType="fitCenter"
            android:padding="4dp"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Column Headers -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp"
        android:paddingBottom="2dp"
        android:background="#22FFFFFF">

        <TextView
            android:layout_width="24dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="8sp" />

        <TextView
            android:layout_width="45dp"
            android:layout_height="wrap_content"
            android:text="Code"
            android:textSize="9sp"
            android:textColor="#B3FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Buy"
            android:textSize="9sp"
            android:textColor="#B3FFFFFF"
            android:textStyle="bold"
            android:gravity="end" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Sell"
            android:textSize="9sp"
            android:textColor="#B3FFFFFF"
            android:textStyle="bold"
            android:gravity="end"
            android:layout_marginStart="6dp" />

        <TextView
            android:layout_width="55dp"
            android:layout_height="wrap_content"
            android:text="Change"
            android:textSize="9sp"
            android:textColor="#B3FFFFFF"
            android:textStyle="bold"
            android:gravity="end"
            android:layout_marginStart="6dp" />
    </LinearLayout>

