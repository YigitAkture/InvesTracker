<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="6dp"
    android:gravity="top"
    android:background="@drawable/app_widget_background">

    <!-- Header: Title | Update time | Refresh button  (total height = 28dp) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="InvesTracker"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_update_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Updated: --:--"
            android:textSize="9sp"
            android:textColor="#B3FFFFFF"
            android:layout_marginEnd="6dp"
            android:maxLines="1" />

        <ImageButton
            android:id="@+id/refresh_button"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_popup_sync"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Refresh"
            android:scaleType="fitCenter"
            android:padding="3dp"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Column headers  (total height ≈ 18dp) -->
    <LinearLayout
        android:id="@+id/column_headers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="2dp"
        android:paddingBottom="2dp"
        android:background="#22FFFFFF">

        <!--
            Spacer = icon width (22dp) + icon marginEnd (4dp) = 26dp.
            Aligns column labels with data-row text.
        -->
        <TextView
            android:layout_width="26dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/header_code"
            android:layout_width="45dp"
            android:layout_height="wrap_content"
            android:text="Code"
            android:textSize="9sp"
            android:textColor="#B3FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/header_buy"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Buy"
            android:textSize="9sp"
            android:textColor="#B3FFFFFF"
            android:textStyle="bold"
            android:gravity="end" />

        <TextView
            android:id="@+id/header_sell"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Sell"
            android:textSize="9sp"
            android:textColor="#B3FFFFFF"
            android:textStyle="bold"
            android:gravity="end"
            android:layout_marginStart="6dp" />

        <TextView
            android:id="@+id/header_change"
            android:layout_width="58dp"
            android:layout_height="wrap_content"
            android:text="Change"
            android:textSize="9sp"
            android:textColor="#B3FFFFFF"
            android:textStyle="bold"
            android:gravity="end"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <!-- Currency container — always populated (Mode 1, 2, 3) -->
    <LinearLayout
        android:id="@+id/currency_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <!--
        Divider 1: currencies ↔ golds
        1dp + 2dp marginTop + 6dp marginBottom = 9dp total
        Shown in Mode 2 and Mode 3 only.
    -->
    <TextView
        android:id="@+id/divider_1"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#33FFFFFF"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="6dp"
        android:visibility="gone" />

    <!-- Gold container — populated in Mode 2 and Mode 3 -->
    <LinearLayout
        android:id="@+id/gold_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <!--
        Divider 2: golds ↔ cryptos
        Same 9dp total.
        Shown in Mode 3 only.
    -->
    <TextView
        android:id="@+id/divider_2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#33FFFFFF"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="6dp"
        android:visibility="gone" />

    <!-- Crypto container — populated in Mode 3 only -->
    <LinearLayout
        android:id="@+id/crypto_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</LinearLayout>