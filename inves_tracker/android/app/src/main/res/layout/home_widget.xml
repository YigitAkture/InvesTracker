<?xml version="1.0" encoding="utf-8"?>
<!--
    Dynamic Home Widget Layout for InvesTracker
    Uses container-based approach for adaptive item rendering
    Automatically adjusts visible items based on widget height
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/app_widget_background">

    <!-- Header with Title, Update Time and Refresh Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="InvesTracker"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/widget_update_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Updated: --:--"
            android:textSize="9sp"
            android:textColor="#B3FFFFFF"
            android:layout_marginEnd="8dp" />

        <!-- Refresh Button -->
        <ImageButton
            android:id="@+id/refresh_button"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_popup_sync"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Refresh"
            android:scaleType="fitCenter"
            android:padding="4dp"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Column Headers -->
    <LinearLayout
        android:id="@+id/column_headers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp"
        android:paddingBottom="2dp"
        android:background="#22FFFFFF">

        <TextView
            android:layout_width="24dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="8sp" />

        <TextView
            android:id="@+id/header_code"
            android:layout_width="45dp"
            android:layout_height="wrap_content"
            android:text="Code"
            android:textSize="9sp"
            android:textColor="#B3FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/header_buy"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Buy"
            android:textSize="9sp"
            android:textColor="#B3FFFFFF"
            android:textStyle="bold"
            android:gravity="end" />

        <TextView
            android:id="@+id/header_sell"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Sell"
            android:textSize="9sp"
            android:textColor="#B3FFFFFF"
            android:textStyle="bold"
            android:gravity="end"
            android:layout_marginStart="6dp" />

        <TextView
            android:id="@+id/header_change"
            android:layout_width="55dp"
            android:layout_height="wrap_content"
            android:text="Change"
            android:textSize="9sp"
            android:textColor="#B3FFFFFF"
            android:textStyle="bold"
            android:gravity="end"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <!-- Currency Container - dynamically populated -->
    <LinearLayout
        android:id="@+id/currency_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <!-- Divider 1 (between currencies and golds) -->
    <TextView
        android:id="@+id/divider_1"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#33FFFFFF"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <!-- Gold Container - dynamically populated -->
    <LinearLayout
        android:id="@+id/gold_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <!-- Divider 2 (between golds and cryptos) -->
    <TextView
        android:id="@+id/divider_2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#33FFFFFF"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <!-- Crypto Container - dynamically populated -->
    <LinearLayout
        android:id="@+id/crypto_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</LinearLayout>