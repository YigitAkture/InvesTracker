            android:layout_height="wrap_content"
            android:text="0.0000"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:gravity="end" />

        <TextView
            android:id="@+id/item_3_selling"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="0.0000"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:gravity="end"
            android:layout_marginStart="6dp" />

        <TextView
