<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/app_widget_background">

    <!-- Header with Title and Refresh Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="InvesTracker"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/widget_update_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Updated: --:--"
            android:textSize="9sp"
            android:textColor="#B3FFFFFF"
            android:layout_marginEnd="8dp" />

        <!-- Refresh Button -->
        <ImageButton
            android:id="@+id/refresh_button"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_popup_sync"
            android:background="transparent"
            android:contentDescription="Refresh"
            android:scaleType="fitCenter"
            android:padding="4dp"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Column Headers -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp"
        android:paddingBottom="2dp"
        android:background="#22FFFFFF">

        <TextView
            android:layout_width="24dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="8sp" />

        <TextView
            android:layout_width="45dp"
            android:layout_height="wrap_content"
            android:text="Code"
            android:textSize="9sp"
            android:textColor="#B3FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Buy"
            android:textSize="9sp"
            android:textColor="#B3FFFFFF"
            android:textStyle="bold"
            android:gravity="end" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Sell"
            android:textSize="9sp"
            android:textColor="#B3FFFFFF"
            android:textStyle="bold"
            android:gravity="end"
            android:layout_marginStart="6dp" />

        <TextView
            android:layout_width="55dp"
            android:layout_height="wrap_content"
            android:text="Change"
            android:textSize="9sp"
            android:textColor="#B3FFFFFF"
            android:textStyle="bold"
            android:gravity="end"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <!-- Item 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="3dp"
        android:paddingVertical="2dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/item_1_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:scaleType="fitCenter"
            android:layout_marginEnd="4dp"
            android:contentDescription="Icon" />

        <TextView
            android:id="@+id/item_1_code"
            android:layout_width="45dp"
            android:layout_height="wrap_content"
            android:text="USD"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/item_1_buying"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="0.0000"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:gravity="end" />

        <TextView
            android:id="@+id/item_1_selling"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="0.0000"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:gravity="end"
            android:layout_marginStart="6dp" />

        <TextView
            android:id="@+id/item_1_change"
            android:layout_width="55dp"
            android:layout_height="wrap_content"
            android:text="↑ 0.00%"
            android:textSize="10sp"
            android:textColor="#4CAF50"
            android:gravity="end"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <!-- Item 2 -->
    <LinearLayout
