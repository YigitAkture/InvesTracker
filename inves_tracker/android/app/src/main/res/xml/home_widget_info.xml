<?xml version="1.0" encoding="utf-8"?>
<appwidget-provider
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/app_widget_description"
    android:initialLayout="@layout/home_widget"
    android:initialKeyguardLayout="@layout/home_widget"
    android:previewLayout="@layout/home_widget_preview"
    android:previewImage="@drawable/example_appwidget_preview"

    android:targetCellWidth="4"
    android:targetCellHeight="2"

    android:minWidth="320dp"
    android:minHeight="200dp"

    android:resizeMode="horizontal|vertical"
    android:minResizeWidth="320dp"
    android:minResizeHeight="200dp"
    android:maxResizeHeight="492dp"

    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable"
    />